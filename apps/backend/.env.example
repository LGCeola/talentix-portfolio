DATABASE_URL=postgresql+psycopg2://usuario:senha@localhost:5432/talentix
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-com-no-minimo-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Opcional: padrão é apps/backend/uploads
# UPLOAD_DIR=C:/talentix/uploads
MAX_RESUME_SIZE_MB=5
# Detector externo opcional (TypeSafe Jev). Ligar exige atualizar o consentimento da candidatura.
JEV_ENABLED=false
JEV_SECRET_KEY=
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_SECONDS=1.5
# Só na Azure (deixe em branco localmente):
# com a URL da conta, os currículos vão para o Blob Storage, acessado pela identidade gerenciada.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=curriculos
# com a connection string, requisições, erros e logs vão para o Application Insights.
APPLICATIONINSIGHTS_CONNECTION_STRING=
ENVIRONMENT=local
