# ==============================================================================
# .gitignore — apps/backend (Python / FastAPI)
# ==============================================================================

# Variáveis de ambiente (segredos locais)
.env
.env.*
!.env.example

# Currículos enviados pelos usuários (dados pessoais — LGPD)
uploads/

# Cache do Python
__pycache__/
*.pyc
*.pyo

# Pacotes e distribuição
*.egg-info/
dist/
build/

# Testes e cobertura
.pytest_cache/
.coverage
htmlcov/
