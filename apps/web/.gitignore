# ==============================================================================
# .gitignore — apps/web (Vue.js / Node)
# ==============================================================================

# Variáveis de ambiente (segredos locais)
.env
.env.*
!.env.example

# Dependências
node_modules/

# Build e output
dist/
.output/

# Cache de ferramentas
.vite/
.nuxt/
.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testes e cobertura
coverage/
